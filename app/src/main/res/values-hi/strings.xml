    <!-- App Info & Privacy Policy -->
    <string name="info_version">संस्करण %1$s</string>
    <string name="info_independence_title">स्वतंत्र एप्लिकेशन</string>
    <string name="info_independence_body">EmotePack एक स्वतंत्र टूल है और यह 7TV या WhatsApp / Meta से संबद्ध, समर्थित या प्रायोजित नहीं है।</string>
    <string name="info_license_title">लाइसेंस आधार (चरण 1)</string>
    <string name="info_license_body">यह प्रारंभिक संस्करण प्रकाशन से पहले औपचारिक कानूनी समीक्षा के अधीन Creative Commons Attribution-ShareAlike 3.0 (CC BY-SA 3.0) लाइसेंस ढांचे के तहत कार्य करता है। प्रत्येक इमोट के लिए अतिरिक्त कानूनी जांच के बिना इमोट्स सीधे सार्वजनिक 7TV कैटलॉग से प्राप्त किए जाते हैं।</string>
    <string name="info_specs_title">स्टिकर रूपांतरण विनिर्देश</string>
    <string name="info_specs_body">• 1 कलेक्शन = 1 WhatsApp पैक (3 से 30 स्टिकर; 1–2 ड्राफ़्ट के रूप में स्थानीय रूप से सहेजे जाते हैं)।\n• स्थिर: 512×512 WebP, अधिकतम 100 KB, पारदर्शी पृष्ठभूमि, कोई कृत्रिम सफेद बॉर्डर नहीं।\n• एनिमेटेड: 512×512 एनिमेटेड WebP, अधिकतम 500 KB, अधिकतम 10s, न्यूनतम 8 ms/फ़्रेम, पारदर्शिता सुरक्षित।\n• मिश्रित पैक: स्थिर इमोट्स स्वचालित रूप से fake-vid एनिमेटेड WebP का उपयोग करते हैं ताकि सब एक पैक में रहे।\n• ट्रे आइकन: 96×96 PNG, अधिकतम 50 KB।</string>
    <string name="privacy_policy_title">गोपनीयता नीति</string>
    <string name="privacy_policy_body">EmotePack सभी इमोट रूपांतरण आपके डिवाइस पर ही संसाधित करता है और सभी स्टिकर कलेक्शन केवल आपके डिवाइस पर संग्रहीत करता है। कोई व्यक्तिगत खाता, एनालिटिक्स ट्रैकर या EmotePack द्वारा संचालित रिमोट सर्वर उपयोग नहीं किया जाता। नेटवर्क अनुरोध केवल तभी सार्वजनिक 7TV API और CDN को भेजे जाते हैं जब आप इमोट खोजते या डाउनलोड करते हैं, और WhatsApp के साथ साझा करना आपके द्वारा शुरू करने पर Android Intent और ContentProvider के माध्यम से स्थानीय रूप से होता है।</string>

