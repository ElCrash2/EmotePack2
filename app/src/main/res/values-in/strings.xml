    <!-- App Info & Privacy Policy -->
    <string name="info_version">Versi %1$s</string>
    <string name="info_independence_title">Aplikasi Independen</string>
    <string name="info_independence_body">EmotePack adalah alat independen dan tidak berafiliasi dengan, didukung oleh, atau disponsori oleh 7TV maupun WhatsApp / Meta.</string>
    <string name="info_license_title">Dasar Lisensi (Fase 1)</string>
    <string name="info_license_body">Rilis awal ini beroperasi di bawah kerangka lisensi Creative Commons Attribution-ShareAlike 3.0 (CC BY-SA 3.0) sambil menunggu peninjauan hukum resmi sebelum publikasi. Emote diambil langsung dari katalog publik 7TV tanpa pemeriksaan hukum tambahan per emote.</string>
    <string name="info_specs_title">Spesifikasi Konversi Stiker</string>
    <string name="info_specs_body">• 1 Koleksi = 1 Paket WhatsApp (3 hingga 30 stiker; 1–2 disimpan lokal sebagai draf).\n• Statis: WebP 512×512, maks. 100 KB, latar transparan, tanpa bingkai putih buatan.\n• Animasi: WebP animasi 512×512, maks. 500 KB, maks. 10d, min. 8 ms/frame, menjaga transparansi.\n• Paket campuran: Emote statis otomatis memakai WebP animasi fake-vid agar semua tetap dalam satu paket.\n• Ikon baki: PNG 96×96, maks. 50 KB.</string>
    <string name="privacy_policy_title">Kebijakan Privasi</string>
    <string name="privacy_policy_body">EmotePack memproses seluruh konversi emote dan menyimpan semua koleksi stiker secara eksklusif di perangkat Anda. Tidak ada akun pengguna pribadi, pelacak analitik, atau server jarak jauh milik EmotePack yang digunakan. Permintaan jaringan hanya dikirim ke API publik dan CDN 7TV saat Anda mencari atau mengunduh emote, dan pengiriman ke WhatsApp berlangsung secara lokal melalui Intent dan ContentProvider saat Anda memulainya.</string>

