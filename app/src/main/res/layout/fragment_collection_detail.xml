<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Single Pack Summary Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_detail_tray_icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_emote_stage"
                        android:contentDescription="@string/nav_my_packs"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_detail_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tv_detail_counts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/accent_cyan" />

                        <TextView
                            android:id="@+id/tv_detail_format"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_summary_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/status_success" />

                <TextView
                    android:id="@+id/tv_detail_whatsapp_env"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_secondary" />

                <!-- Primary Single-Pack Send to WhatsApp Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_to_whatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/send_to_whatsapp"
                    android:textColor="@color/on_accent_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_share_pack"
                    app:iconTint="@color/on_accent_dark" />

                <TextView
                    android:id="@+id/tv_whatsapp_requirement_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/status_warning"
                    android:visibility="gone" />

                <!-- Edit Pack & Cancel Creation / Delete Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_collection"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/edit_collection"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        app:backgroundTint="@color/surface_highlight"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_edit"
                        app:iconTint="@color/accent_cyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_collection"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/space_grotesk"
                        android:text="@string/delete_collection"
                        android:textColor="@color/status_error"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/status_error"
                        app:strokeColor="@color/status_error_bg" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Unified Stickers Grid -->
        <TextView
            android:id="@+id/tv_all_stickers_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
            android:textColor="@color/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_local_stickers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
