<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_base"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_base"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIconTint="@color/text_primary"
            app:titleTextColor="@color/text_primary">

            <LinearLayout
                android:id="@+id/toolbar_brand_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/toolbar_logo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_art" />

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Top-right icon-only Settings gear button (shown on root tabs) -->
            <ImageButton
                android:id="@+id/btn_toolbar_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_settings"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

            <!-- Top-right Create Pack button shown in emote selection screens -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolbar_create_pack_btn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/create_pack_action"
                android:fontFamily="@font/space_grotesk"
                android:minWidth="48dp"
                android:paddingHorizontal="14dp"
                android:text="@string/create_pack_action"
                android:textColor="@color/on_accent_dark"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/accent_cyan"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_sticker_add"
                app:iconPadding="6dp"
                app:iconTint="@color/on_accent_dark" />
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/top_tab_layout"
            style="@style/Widget.EmotePack.TopTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabGravity="fill"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_subtle" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
