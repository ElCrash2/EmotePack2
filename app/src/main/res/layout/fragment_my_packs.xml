<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Active/paused background job banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_resume_job"
        style="@style/Widget.EmotePack.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/accent_cyan_container"
        app:strokeColor="@color/accent_cyan">

        <TextView
            android:id="@+id/tv_resume_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_my_packs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="28dp" />

        <LinearLayout
            android:id="@+id/empty_packs_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_emote_stage"
                android:contentDescription="@string/nav_my_packs"
                android:padding="14dp"
                android:src="@drawable/ic_launcher_art" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/my_packs_empty_title"
                android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/my_packs_empty_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_home"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/space_grotesk"
                android:paddingHorizontal="20dp"
                android:text="@string/my_packs_go_home"
                android:textColor="@color/on_accent_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_cyan"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
