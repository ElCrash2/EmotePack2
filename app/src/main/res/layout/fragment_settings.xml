<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Language Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_section"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tv_current_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/text_secondary" />

                <RadioGroup
                    android:id="@+id/rg_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_system"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_system"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_de"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_de"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_en"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_en"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_es"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_es"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_fr"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_fr"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_id"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_id"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_pt"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_pt"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_ru"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_ru"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_hi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_hi"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Storage & Cache Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_storage_section"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tv_storage_collections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_storage_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_storage_free"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_cache"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_clear_cache"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/surface_highlight"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section Divider: App Information & Privacy Policy -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/stroke_subtle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/nav_app_info"
            android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <!-- Brand & Version Header Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_7tv"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_art" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_app_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/accent_cyan" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7TV Source Info -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_7tv_info"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_7tv_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Independence Notice -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_independence_title"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/info_independence_body"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sticker Specs -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_specs_title"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/info_specs_body"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- License Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_license_title"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/info_license_body"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy Policy Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy_title"
                    android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/privacy_policy_body"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
