<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Language Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_section"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/text_secondary" />

                <RadioGroup
                    android:id="@+id/rg_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_system"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_system"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_de"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_de"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_en"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_en"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_es"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_es"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_fr"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_fr"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_id"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_id"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_pt"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_pt"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_ru"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_ru"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_lang_hi"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/lang_hi"
                        android:textColor="@color/text_primary" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Storage & Cache Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_storage_section"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_storage_collections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_storage_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_storage_free"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_cache"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_clear_cache"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/surface_highlight"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Backup Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_backup_section"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_export"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/backup_export"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_backup"
                        app:iconTint="@color/accent_cyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_import"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/backup_import"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_restore"
                        app:iconTint="@color/accent_violet" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About / 7TV / Privacy Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_7tv_info"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/settings_7tv_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_app_info"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/nav_app_info"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_privacy"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_privacy_policy"
                    android:textColor="@color/accent_cyan"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
