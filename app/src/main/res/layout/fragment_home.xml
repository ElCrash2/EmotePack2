<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 7TV-Inspired Hero Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_7tv"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_static"
                    android:fontFamily="@font/space_grotesk"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/app_tagline"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_hero_title"
                    android:textAppearance="@style/TextAppearance.EmotePack.DisplayTitle"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/home_hero_subtitle"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dual Independent Search Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EmotePack.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/active_mode_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_static"
                    android:fontFamily="@font/space_grotesk"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/search_active_mode_streamer"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/accent_cyan"
                    android:textStyle="bold" />

                <!-- Search Box 1: Search Streamer -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_search_streamer"
                    style="@style/Widget.EmotePack.SearchBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/search_streamer_label"
                    app:endIconMode="clear_text"
                    app:placeholderText="@string/search_streamer_hint"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/accent_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_search_streamer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Search Box 2: Search Emote -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_search_emote"
                    style="@style/Widget.EmotePack.SearchBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/search_emote_label"
                    app:endIconMode="clear_text"
                    app:placeholderText="@string/search_emote_hint"
                    app:startIconDrawable="@drawable/ic_emoji"
                    app:startIconTint="@color/accent_violet">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_search_emote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Single Search Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/space_grotesk"
                    android:text="@string/search_button"
                    android:textColor="@color/on_accent_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_cyan"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@color/on_accent_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Streamer Results Section -->
        <LinearLayout
            android:id="@+id/streamer_results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_results_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/search_results_streamers_title"
                android:textAppearance="@style/TextAppearance.EmotePack.SectionTitle"
                android:textColor="@color/text_primary" />

            <ProgressBar
                android:id="@+id/progress_streamers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="16dp"
                android:indeterminateTint="@color/accent_cyan"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_streamers_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_streamers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_more_streamers"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/space_grotesk"
                android:text="@string/search_load_more"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:strokeColor="@color/stroke_subtle" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
