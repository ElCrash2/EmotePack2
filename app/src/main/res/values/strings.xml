    <!-- App Info & Privacy Policy -->
    <string name="info_version">Version %1$s</string>
    <string name="info_independence_title">Independent Application</string>
    <string name="info_independence_body">EmotePack is an independent tool and is not affiliated with, endorsed by, or sponsored by 7TV or WhatsApp / Meta.</string>
    <string name="info_license_title">License Premise (Phase 1)</string>
    <string name="info_license_body">This initial release operates under the Creative Commons Attribution-ShareAlike 3.0 (CC BY-SA 3.0) license framework pending formal pre-publication legal review. Emotes are fetched directly from public 7TV catalogs without performing extra per-emote legal lookups.</string>
    <string name="info_specs_title">Sticker Conversion Specs</string>
    <string name="info_specs_body">• 1 Collection = 1 WhatsApp Pack (3 to 30 stickers; 1–2 saved locally as draft).\n• Static: 512×512 WebP, max 100 KB, transparent background, no artificial white border.\n• Animated: 512×512 animated WebP, max 500 KB, max 10s, min 8 ms/frame, preserves transparency.\n• Mixed packs: Static emotes automatically use fake-vid animated WebP so everything stays in a single pack.\n• Tray icon: 96×96 PNG, max 50 KB.</string>
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_body">EmotePack processes all emote conversions and stores all sticker collections strictly on your device. No personal user accounts, analytics trackers, or remote servers operated by EmotePack are used. Network requests are sent only to 7TV public APIs and CDNs when you search or download emotes, and sticker sharing occurs locally via Android Intent and ContentProvider with WhatsApp when you explicitly initiate it.</string>

